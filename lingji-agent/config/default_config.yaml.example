llm:
  api_key: ""
  base_url: https://api.deepseek.com
  model: deepseek-chat
  provider: deepseek
network:
  auth_token: ""
  # 每台 PC 使用唯一 device_id（如 lingji-pc、lingji-laptop）；手机 Web 通过 target_agent_id 选择目标
  device_id: lingji-pc
  display_name: 青铜剑
  aliases:
    - 青铜剑
    - 主PC
    - Primary PC
  gateway_host: lingji.mygoal.tech
  gateway_port: 443
  incoming_dir: ~/Downloads/LingjiIncoming
  max_reconnect_delay: 60.0
  reconnect_delay: 1.0
security:
  hitl_enabled: true
  hitl_timeout_sec: 300
  sanitizer_force_docker: true
  guardrails_enabled: true
  guardrails_block: true
  max_execution_time: 30
  max_memory_mb: 256
  sandbox_image: python:3.11-slim
memory:
  enabled: true
  db_path: ~/.lingji/memory_db
  episodic_top_k: 3
  semantic_top_k: 2
  tool_output_max_chars: 1000
  decay_enabled: true
  decay_lambda: 0.01
  prune_min_weight: 0.05
  prune_after_days: 30
  summarize_enabled: true
  summarize_min_episodes: 30
  summarize_batch_size: 20
  summarize_min_age_days: 7
  summarize_interval_hours: 24
  summarize_max_output_chars: 2000
  summarize_cold_start_defer: true  # 无 .summarize_last_run 时先 seed，24h 后再首次总结
observability:
  enabled: true
  otlp_endpoint: http://127.0.0.1:4317
  otlp_insecure: true
  service_name: lingji-agent
  metrics_enabled: true
  metrics_host: 127.0.0.1
  metrics_port: 9091
  trace_log_enabled: true
scheduler:
  # 值守机（青铜剑）：enabled=false，scheduler_agent_id 指向移动调度终端
  enabled: false
  scheduler_agent_id: lingji-laptop
  guardian_executor_ids: []
# 机要栏（仅空城记填写；argv 列表禁止写成一条 shell 字符串；密钥勿提交）
hermes_session:
  start_cmd: []          # 例: ["/usr/local/bin/hermes", "gateway"]
  stop_cmd: []           # 例: ["pkill", "-x", "hermes"]；空则按 process_names pkill -x 第一个
  process_names:
    - hermes
    - openclaw
  health_url: ""         # 可选，仅 127.0.0.1 / localhost
  chat_url: ""           # 有本机 HTTP 会话接口才填；空则在线但通道未接通
  chat_timeout_sec: 60
  start_wait_sec: 3
# 编码监工（仅青铜剑填写；空城记保持 start_cmd / jobs_root / lead_cmd 为空）
# lead_cmd 禁止含 --force / --yolo
coding:
  jobs_root: ""
  start_cmd: []
  lead_cmd: []
  timeout_sec: 14400       # 4h 软超时
  timeout_hard_sec: 28800   # 8h 硬超时
  hung_sec: 900             # 15min 无日志增长判 hung
  heartbeat_sec: 15
  progress_sec: 30
  lead_round_timeout_sec: 1200
  lead_max_question_rounds: 3
  source_git_allowlist: []
